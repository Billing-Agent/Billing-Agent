# FastAPI
PROJECT_NAME="Billing Agent API"
API_V1_STR="/api/v1"

# Database Configuration
# Do not use real credentials here!
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/billing_agent

# AI Agent Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Payment Provider Configuration
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_API_KEY=
# PayHere Retrieval API (OAuth & Merchant payment search)
PAYHERE_API_APP_ID=
PAYHERE_API_APP_SECRET=
PAYHERE_MERCHANT_API_BASE_URL=https://sandbox.payhere.lk/merchant/v1
# PayHere sandbox checkout URL (switch to https://www.payhere.lk/pay/checkout for production)
PAYHERE_BASE_URL=https://sandbox.payhere.lk/pay/checkout
# Public URL PayHere POSTs callback to — must be reachable from the internet (use ngrok locally)
PAYHERE_NOTIFY_URL=
# Deep-link or URL Flutter handles after successful/cancelled payment
PAYHERE_RETURN_URL=
PAYHERE_CANCEL_URL=
# Payer address defaults used when user profile has no address
PAYHERE_DEFAULT_ADDRESS=No. 1 Main Street
PAYHERE_DEFAULT_CITY=Colombo
PAYHERE_DEFAULT_COUNTRY=Sri Lanka

# Authentication Configuration (Future phase)
JWT_SECRET=
